#compdef nightshift

_nightshift() {
  local -a commands
  commands=(
    'doctor:Report whether this machine can run autonomous work'
    'status:Report what is running, which shift, and what is next'
    'queue:Inspect and edit the work queue'
    'budget:Report quota usage and whether work may run now'
    'budget-check:Answer the mid-run budget hook for a running task'
    'tick:Decide whether to start work now, and start it in tmux'
    'start-shift:Run a shift now, outside the configured schedule'
    'run-task:Take one queue row through plan and implementation'
    'add-repo:Register a repository so it can be queued and worked'
    'init-repo:Write the AGENTS.md brief and CLAUDE.md pointer into a repository'
    'create-issue:Interactively plan and file a GitHub issue, then queue it'
    'add-issue:Estimate an existing GitHub issue and queue it'
    'update:Rebuild and replace this binary from source'
    'version:Print the version'
    'completion:Emit a shell completion script for zsh or bash'
    'help:Show usage'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'nightshift command' commands
    return
  fi

  local cmd=${words[2]}
  shift words
  (( CURRENT-- ))
  case $cmd in
    doctor)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--json[emit checks as JSON]'
      ;;
    status)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files'
      ;;
    budget)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files'
      ;;
    budget-check)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--task=[the task this run is working]:task:'
      ;;
    tick)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--dry-run[report what would be launched and exit]'
      ;;
    start-shift)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--dry-run[evaluate the budget once and exit]' \
        '--end-time=[when the shift ends, as HH:MM]:end-time:' \
        '--session-limit=[session usage ceiling]:session-limit:' \
        '--weekly-limit=[weekly usage ceiling]:weekly-limit:'
      ;;
    run-task)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--dry-run[report what would run and exit]' \
        '--end-time=[when the manual shift ends, as HH:MM (only with --manual; default: five hours from now)]:end-time:' \
        '--manual[run outside the configured shift schedule, evaluating an ephemeral shift instead of refusing with no_shift (see '\''nightshift start-shift'\'', which this replaces: that command evaluates a shift but has nothing to hand this one)]' \
        '--no-tmux[run directly in this shell instead of relaunching inside the shared tmux session]' \
        '--session-limit=[session usage ceiling for a manual shift (only with --manual)]:session-limit:' \
        '--task=[task to run]:task:' \
        '--timeout=[ceiling for the orchestrator session]:timeout:' \
        '--weekly-limit=[weekly usage ceiling for a manual shift (only with --manual)]:weekly-limit:'
      ;;
    add-repo)
      _arguments \
        '--help[show usage]' \
        '--client-key=[required when owner-class is client]:client-key:' \
        '--config=[configuration file]:config:_files' \
        '--owner-class=[internal or client]:owner-class:' \
        '--verify=[comma-separated deterministic checks]:verify:'
      ;;
    init-repo)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--force[overwrite existing files]'
      ;;
    create-issue)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--model=[model for the planning session]:model:'
      ;;
    add-issue)
      _arguments \
        '--help[show usage]' \
        '--config=[configuration file]:config:_files' \
        '--model=[model for the estimating session]:model:'
      ;;
    update)
      _arguments \
        '--help[show usage]' \
        '--check[report what would happen and exit]' \
        '--config=[configuration file]:config:_files' \
        '--no-pull[do not fetch before building]' \
        '--skip-tests[do not run tests before installing]' \
        '--source=[checkout to build from]:source:_files'
      ;;
    completion)
      _arguments '1:completion:(zsh bash)'
      ;;
    queue)
      if (( CURRENT == 2 )); then
        local -a sub
        sub=(
          'list'
          'show'
          'add'
          'set-status'
          'help'
        )
        _describe -t queue-commands 'queue subcommand' sub
        return
      fi
      shift words
      (( CURRENT-- ))
      case ${words[1]} in
        list)
          _arguments \
            '--help[show usage]' \
            '--all[show entire history, ignoring --since]' \
            '--config=[configuration file]:config:_files' \
            '--format=[output format: text, json, or csv]:format:' \
            '--since=[only show tasks touched within this window, e.g. 24h or 7d; ignored with --all]:since:'
          ;;
        show)
          _arguments \
            '--help[show usage]' \
            '--config=[configuration file]:config:_files'
          ;;
        add)
          _arguments \
            '--help[show usage]' \
            '--client=[client name]:client:' \
            '--config=[configuration file]:config:_files' \
            '--estimate-source=[who produced --hours: human or agent]:estimate-source:' \
            '--hours=[estimated manual hours for a competent engineer working unaided]:hours:' \
            '--id=[task id (assigned sequentially when omitted)]:id:' \
            '--issue=[issue URL]:issue:' \
            '--notes=[free-text notes]:notes:' \
            '--pin=[non-empty pins the task above the owner-class ordering]:pin:' \
            '--priority=[priority, lower runs first]:priority:' \
            '--project=[project name]:project:' \
            '--repo=[repository as owner/name (required)]:repo:'
          ;;
        set-status)
          _arguments \
            '--help[show usage]' \
            '--config=[configuration file]:config:_files' \
            '--force[bypass the status machine]'
          ;;
      esac
      ;;
  esac
}

_nightshift "$@"
